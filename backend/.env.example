# Copy to backend/.env and fill in. scripts/run-backend.sh loads this file.
GITHUB_TOKEN=github_pat_xxx          # fine-grained PAT, repo: deployhub, permission: Actions read & write
GITHUB_OWNER=your-github-username
GITHUB_REPO=deployhub
JWT_SECRET=replace-with-at-least-32-random-characters
# Linux: <output of `minikube ip`>.nip.io   macOS/Windows (with `minikube tunnel`): 127.0.0.1.nip.io
APP_DOMAIN=127.0.0.1.nip.io
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
